#!/usr/bin/env bash
# Check installed runtime and CPU behavior without downloading browser binaries.
set -euo pipefail
task_platform_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$task_platform_root"
task_require_town02=0
case "${1:-}" in
  --require-town02) task_require_town02=1 ;;
  '') ;;
  *) printf '%s\n' 'Usage: scripts/platform/check [--require-town02]' >&2; exit 2 ;;
esac
task_platform_python="${WIWO_PYTHON:-$task_platform_root/.venv-full/bin/python}"
export PATH="$task_platform_root/.envs/python311/bin:$PATH"
export CUDA_VISIBLE_DEVICES=-1 WIWO_GPU=-1 OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2
export MPLCONFIGDIR="$task_platform_root/.cache/matplotlib"
"$task_platform_python" -m pip check
"$task_platform_python" -m wiwo_ma.platform.cli doctor
task_town02_status="$("$task_platform_python" -m wiwo_ma.platform.town02 status)"
printf '%s\n' "$task_town02_status"
task_town02_available="$("$task_platform_python" -c 'import json,sys; print(json.loads(sys.argv[1])["status"])' "$task_town02_status")"
task_test_args=()
if [[ "$task_town02_available" == available ]]; then
  "$task_platform_python" -m wiwo_ma.platform.town02 check
  "$task_platform_python" -m wiwo_ma.platform.town02_materials check
  task_test_args+=(--require-town02)
elif [[ "$task_require_town02" == 1 ]]; then
  "$task_platform_python" -m wiwo_ma.platform.town02 status --require
fi
if [[ "$task_platform_python" == "$task_platform_root/.venv-full/bin/python" ]]; then
  touch "$task_platform_root/.venv-full/.wiwo-runtime-ready"
fi
"$task_platform_python" -m ruff check src tests examples scripts
"$task_platform_python" -m compileall -q src examples scripts
"$task_platform_python" -m pytest tests/platform -q --strict-markers --strict-config "${task_test_args[@]}"
if [[ "$task_town02_available" == available ]]; then
  "$task_platform_python" examples/01_single_ma.py --headless
  "$task_platform_python" examples/02_dynamic_6dma.py --headless
  printf '%s\n' 'Runtime and CPU checks passed, including the complete external Town02 map.'
else
  "$task_platform_python" examples/01_single_ma.py --headless --config configs/platform/single_ma_bounded.json
  "$task_platform_python" examples/02_dynamic_6dma.py --headless --config configs/platform/munich_continuous_full64_4s_NOT_authorized.json
  printf '%s\n' 'Runtime and CPU checks passed without external Town02 assets; import the map to enable Town02 preview.'
fi
