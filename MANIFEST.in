include README.md LICENSE CITATION.md CHANGELOG.md CONTRIBUTING.md SECURITY.md THIRD_PARTY_NOTICES.md
include requirements-platform-validated.txt requirements-dev.lock.txt
recursive-include assets *.obj *.xml *.js LICENSE-Viser
recursive-include configs *.json
recursive-include examples *.py
recursive-include scripts *.py run
recursive-include tests *.py *.json
recursive-include docs *.md *.json *.png *.gif *.svg
prune .releasework
prune artifacts
prune experiments
prune .cache
global-exclude *.pyc *.h5 *.hdf5 *.npy *.npz
